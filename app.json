{
  "expo": {
    "name": "Calendar of All Calendars",
    "slug": "household-hub",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "scheme": "calendarofallcalendars",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.booplenoodle.calendarofallcalendars"
    },
    "android": {
      "package": "com.booplenoodle.calendarofallcalendars",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "build": {
        "output": "dist",
        "assets": "assets"
      }
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "cd057a46-0853-493e-91c5-8c684c6222bf"
      }
    }
  }
}